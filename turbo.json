{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "API_INTERNAL_URL",
        "MEDIA_PROXY_ORIGIN",
        "NEXT_OUTPUT",
        "NEXT_PUBLIC_*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
