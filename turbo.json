{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^bundle"
      ],
      "env": [
        "API_INTERNAL_URL",
        "CMS_PUBLIC_URL",
        "MEDIA_PROXY_ORIGIN",
        "NEXT_OUTPUT",
        "NEXT_PUBLIC_*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/module-assets/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "^bundle"
      ]
    },
    "test": {
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "CI"
      ],
      "dependsOn": [
        "^bundle"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "bundle": {
      "inputs": [
        "src/**",
        "scripts/**",
        "$TURBO_ROOT$/packages/module-sdk/src/**",
        "$TURBO_ROOT$/packages/module-bundler/src/**"
      ],
      "outputs": [
        "bundles/**"
      ]
    }
  }
}
