# Mẫu biến môi trường. Sao chép thành .env khi chạy trên máy; trên Vercel, nhập trong
# Settings → Environment Variables của từng dự án. Không đưa giá trị thật vào repo.

# ---------- API (apps/api) ----------
# Cổng khi chạy như máy chủ Node.js (không dùng trên Vercel).
PORT=4000
# Chuỗi kết nối PostgreSQL (Neon khi chạy tạm). Dùng từ Bước 3.
DATABASE_URL=postgres://opes:opes@localhost:5432/gamehub
# true: API tự chạy migration khi khởi động (dùng trong Docker). Trên Vercel để trống:
# migration do GitHub Actions chạy khi gộp vào main.
RUN_MIGRATIONS=
# Thư mục migration khi chạy bản build (Docker đặt sẵn /app/migrations).
MIGRATIONS_DIR=
# Cơ sở dữ liệu riêng cho kiểm thử tích hợp (sẽ bị xoá sạch dữ liệu khi chạy test).
TEST_DATABASE_URL=
# Kho media dạng S3 (Cloudflare R2 khi chạy tạm, MinIO khi chạy máy chủ riêng). Xem docs/huong-dan/r2.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=gamehub-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Địa chỉ công khai để hiển thị ảnh, nhạc.
MEDIA_PUBLIC_URL=http://localhost:9000/gamehub-media
# Khóa ký phiên đăng nhập; tối thiểu 32 ký tự ngẫu nhiên. Bắt buộc khi NODE_ENV=production.
SESSION_SECRET=
# Đặt cờ Secure cho cookie đăng nhập. Mặc định: bật khi NODE_ENV=production.
COOKIE_SECURE=
# Địa chỉ trang chơi, dùng để tạo link chơi thử và mã QR. Dùng từ Bước 6.
PLAY_PUBLIC_URL=http://localhost:3001

# ---------- CMS (apps/cms) và trang chơi (apps/play) ----------
# Địa chỉ API mà /api/* được chuyển tiếp tới. Trên Vercel: https://opes-gamehub-api.vercel.app
API_INTERNAL_URL=http://localhost:4000
