# CMS hoặc trang chơi (Next.js). Build từ thư mục gốc repo:
#   docker build -f docker/Dockerfile.next --build-arg APP=cms  -t opes-gamehub-cms .
#   docker build -f docker/Dockerfile.next --build-arg APP=play -t opes-gamehub-play .

FROM node:24-alpine AS build
RUN corepack enable
WORKDIR /repo
ARG APP
# Địa chỉ API mà /api/* chuyển tiếp tới; được ghi vào bản build.
ARG API_INTERNAL_URL=http://api:4000
# Trang chơi: địa chỉ kho media để chuyển tiếp /media/* (để trống = không chuyển tiếp).
ARG MEDIA_PROXY_ORIGIN=
ENV NEXT_OUTPUT=standalone NEXT_TELEMETRY_DISABLED=1 API_INTERNAL_URL=${API_INTERNAL_URL} MEDIA_PROXY_ORIGIN=${MEDIA_PROXY_ORIGIN}
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@opes/${APP}

FROM node:24-alpine AS run
ARG APP
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1 APP_DIR=apps/${APP}
COPY --from=build /repo/apps/${APP}/.next/standalone ./
COPY --from=build /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build /repo/apps/${APP}/public ./apps/${APP}/public
USER node
EXPOSE 3000
CMD ["sh", "-c", "node ${APP_DIR}/server.js"]
